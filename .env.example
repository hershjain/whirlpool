# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# The number the DEV-LOGIN shortcut signs in as. Nothing else reads it: the
# webhook accepts every number and creates an account from the first inbound
# text, and the API is scoped by session. It comes out when DEV-LOGIN does.
OWNER_PHONE_NUMBER=+1XXXXXXXXXX

# Public HTTPS URL Twilio will POST webhooks to. Also used to validate the
# Origin of state-changing requests, and as the domain in the one-time-code
# line of the login SMS - so it must be the origin that serves /login.
# One origin serves all of it: the marketing site, /login, the canvas at /app,
# /api and the webhook. Must be a bare origin - no path, no trailing slash -
# because the Origin check compares it by exact string. The server refuses to
# boot otherwise rather than letting you find out via silent 403s.
# e.g. https://whrlpl.app
#
# Keep this on localhost. To run against a tunnel instead, put the tunnel's
# hostname in .env.tunnel and start with `npm run dev:tunnel`, which layers that
# file over this one - rather than editing this line back and forth.
PUBLIC_BASE_URL=http://localhost:3000

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Postgres. Locally this can be a container:
#   docker run -d --name whirlpool-pg -p 5432:5432 \
#     -e POSTGRES_PASSWORD=whirlpool -e POSTGRES_DB=whirlpool postgres:16
DATABASE_URL="postgresql://postgres:whirlpool@localhost:5432/whirlpool"

# Error reporting (https://sentry.io). Optional: with no DSN, errors are still
# logged, they just do not page anyone.
SENTRY_DSN=

# "production" gates the DEV-LOGIN routes, sets Secure on the session cookie,
# and enables the console-codes guard below. Unset means development. The server
# refuses to boot as development against an https PUBLIC_BASE_URL, because that
# combination is a public deployment with an open auth bypass. That is why
# .env.tunnel sets this to production: an https tunnel trips the same guard.
NODE_ENV=

# How login codes reach people.
#   console - print the code to the server log and send nothing. The default,
#             and what lets the login flow be developed and tested before A2P
#             registration clears.
#   sms     - send it from TWILIO_PHONE_NUMBER for real.
# The server refuses to boot with `console` under NODE_ENV=production unless
# ALLOW_CONSOLE_CODES=1, because a dev transport in production is an
# authentication bypass for anyone who can read the logs. Any other value is
# rejected outright rather than quietly treated as `console`.
LOGIN_CODE_TRANSPORT=console

# Ceiling on login codes sent per day across all users. The backstop against
# an SMS-pumping bill; the per-phone and per-IP limits do the ordinary work.
MAX_DAILY_LOGIN_CODES=200

# Ceiling on how many times one number can reach a model per day - saves,
# questions and digests alike. The same kind of backstop for the Anthropic bill
# that MAX_DAILY_LOGIN_CODES is for the Twilio one. The free commands (list,
# search, help) do not count against it.
MAX_DAILY_MODEL_REQUESTS_PER_PHONE=200

# trace | debug | info | warn | error. Defaults to info in production, debug
# otherwise.
LOG_LEVEL=

PORT=3000
