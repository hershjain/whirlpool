# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Your own phone number - only messages from this number are processed
OWNER_PHONE_NUMBER=+1XXXXXXXXXX

# Public HTTPS URL Twilio will POST webhooks to (used for signature validation)
# e.g. https://whirlpool.fly.dev
PUBLIC_BASE_URL=

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

DATABASE_URL="file:./dev.db"
PORT=3000
