datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Raw, immutable capture - never edited after creation.
model Item {
  id              String   @id @default(cuid())
  phone           String
  type            String // "link" | "note"
  rawUrl          String?
  title           String?
  author          String? // byline / handle, e.g. "@paulg" or "Jane Smith"
  siteName        String? // og:site_name, e.g. "The New York Times"
  // Hero image for this specific page (og:image). A URL, not bytes - these
  // run 100KB-2MB, unlike the favicon cached on SourceProfile.
  imageUrl        String?
  rawText         String // as received in the SMS body
  extractedText   String? // best-effort extracted article/caption text
  contentFidelity String // "full_text" | "metadata_only" | "failed"
  // HTTP status from the last fetch of rawUrl. 404/410 means the page is gone,
  // which the card surfaces - a dead save is worth knowing about rather than
  // silently showing an empty tile. Null when never checked.
  linkStatus      Int?
  messageSid      String   @unique
  createdAt       DateTime @default(now())

  // Position on the canvas moodboard - null until the user drags it there
  // for the first time, at which point the frontend auto-arranges it.
  canvasX Float?
  canvasY Float?

  // Exactly one folder, or none - the canvas draws a folder's members inside a
  // single translucent square, which a tile can't be in two of at once.
  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id])

  enrichmentRuns EnrichmentRun[]

  // phone is the tenant key on every query in repo.ts; createdAt is the sort
  // order all three list queries use. Without this pair each of them scans the
  // whole table and sorts in memory.
  @@index([phone, createdAt])
  @@index([folderId])
}

// User-made collections, as against the LLM's tags and category. Scoped by
// phone like Item, and unique per owner so "Research" means one thing.
model Folder {
  id        String   @id @default(cuid())
  phone     String
  name      String
  createdAt DateTime @default(now())

  // Where this folder's square sits on the board while it is open. Null until
  // the first open, which auto-places it clear of the cards already there.
  canvasX Float?
  canvasY Float?

  items Item[]

  @@unique([phone, name])
  @@index([phone])
}

// One row per (item, model, prompt version) - append-only, never overwritten,
// so different prompts/models can be compared side by side later.
model EnrichmentRun {
  id            String   @id @default(cuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id])
  model         String
  promptVersion String
  summary       String
  tags          String // JSON-encoded string[]
  category      String
  inputTokens   Int
  outputTokens  Int
  createdAt     DateTime @default(now())

  // toItemView looks up the newest run for one item; the bare itemId index
  // found the rows but still sorted them.
  @@index([itemId, createdAt])
}

// Per-hostname branding for the canvas cards - name, color, and a cached
// logo, resolved once per site and reused for every item from it. Keyed by
// normalized hostname ("www." stripped) so http/https and www variants share
// one row.
model SourceProfile {
  hostname    String   @id
  name        String // display name: "X", "YouTube", else the hostname
  color       String // header bar color, "#RRGGBB"
  textColor   String // "#ffffff" | "#000000" - precomputed for contrast on `color`
  iconBase64  String? // cached logo bytes, base64-encoded
  iconMime    String? // "image/png" | "image/svg+xml" | "image/x-icon" | ...
  colorSource String // "curated" | "theme-color" | "manifest" | "icon" | "hash"
  fetchFailed Boolean  @default(false)
  fetchedAt   DateTime @default(now())
}

// Logged chat Q&A exchanges - same append-only logic, doubles as an eval set.
model ChatTurn {
  id            String   @id @default(cuid())
  phone         String
  question      String
  answer        String
  model         String
  promptVersion String
  toolCalls     String? // JSON-encoded log of search_items calls made
  inputTokens   Int
  outputTokens  Int
  messageSid    String   @unique
  createdAt     DateTime @default(now())

  @@index([phone])
}

// Guards against Twilio webhook retries double-processing the same inbound
// message, regardless of which command it maps to.
//
// The row is claimed before the work starts, so a concurrent retry sees it and
// backs off - but it is only *completed* afterwards. That distinction is the
// whole point: a crash or a deploy mid-job used to leave a row that looked
// processed, so Twilio's retry was swallowed and the message was lost with no
// error anywhere. A claim that is still "processing" past CLAIM_STALE_MS is
// treated as abandoned and can be taken over.
model ProcessedMessage {
  messageSid  String    @id
  status      String    @default("processing") // "processing" | "completed"
  claimedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, claimedAt])
}

// Sliding-window rate limiter, one row per allowed hit.
//
// This lived in a module-level Map until the move to Postgres. In memory the
// windows reset on every deploy, which handed everyone - including whoever was
// being limited - a fresh allowance, and that included the global daily ceiling
// on login codes that exists to cap an SMS-pumping bill. Rows are swept hourly.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// --- Identity and sessions ---

// A person, keyed by the phone number they text from. Item/Folder/ChatTurn
// already carry `phone` as a tenant key and deliberately keep no foreign key
// to this table: those rows predate it, and a required relation would make
// the migration fail on every save captured before login existed.
//
// A row is created by the first inbound message from a number - that text is
// both the sign-up and the consent record, which is why the message's SID is
// stored alongside it.
model User {
  phone           String    @id // E.164, e.g. "+14155551234"
  optInAt         DateTime  @default(now())
  optInMessageSid String? // the inbound message that created this user
  // Set when they text STOP. Twilio blocks our sends to an opted-out number
  // anyway (error 21610); mirroring it here means we never attempt the doomed
  // send, and never sit a user in front of a code that cannot arrive.
  optedOutAt      DateTime?
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())

  loginCodes LoginCode[]
  sessions   Session[]
}

// A pending login code. Only the hash is stored - a database dump must not
// hand over live codes. Rows are kept after use rather than deleted so a
// burst of requests is visible; sweepLoginCodes() prunes them.
model LoginCode {
  id         String    @id @default(cuid())
  phone      String
  user       User      @relation(fields: [phone], references: [phone])
  codeHash   String
  expiresAt  DateTime
  // Wrong guesses against this code. At MAX_CODE_ATTEMPTS the code is dead
  // even if the next guess is right - that is what makes six digits enough.
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// A logged-in browser. The cookie holds a random token; this holds its hash,
// so the table cannot be read to mint cookies.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  phone      String
  user       User      @relation(fields: [phone], references: [phone])
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}
