datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Raw, immutable capture - never edited after creation.
model Item {
  id              String   @id @default(cuid())
  phone           String
  type            String // "link" | "note"
  rawUrl          String?
  title           String?
  author          String? // byline / handle, e.g. "@paulg" or "Jane Smith"
  siteName        String? // og:site_name, e.g. "The New York Times"
  // Hero image for this specific page (og:image). A URL, not bytes - these
  // run 100KB-2MB, unlike the favicon cached on SourceProfile.
  imageUrl        String?
  rawText         String // as received in the SMS body
  extractedText   String? // best-effort extracted article/caption text
  contentFidelity String // "full_text" | "metadata_only" | "failed"
  // HTTP status from the last fetch of rawUrl. 404/410 means the page is gone,
  // which the card surfaces - a dead save is worth knowing about rather than
  // silently showing an empty tile. Null when never checked.
  linkStatus      Int?
  messageSid      String   @unique
  createdAt       DateTime @default(now())

  // Position on the canvas moodboard - null until the user drags it there
  // for the first time, at which point the frontend auto-arranges it.
  canvasX Float?
  canvasY Float?

  // Exactly one folder, or none - the canvas draws a folder's members inside a
  // single translucent square, which a tile can't be in two of at once.
  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id])

  enrichmentRuns EnrichmentRun[]

  @@index([folderId])
}

// User-made collections, as against the LLM's tags and category. Scoped by
// phone like Item, and unique per owner so "Research" means one thing.
model Folder {
  id        String   @id @default(cuid())
  phone     String
  name      String
  createdAt DateTime @default(now())

  // Where this folder's square sits on the board while it is open. Null until
  // the first open, which auto-places it clear of the cards already there.
  canvasX Float?
  canvasY Float?

  items Item[]

  @@unique([phone, name])
  @@index([phone])
}

// One row per (item, model, prompt version) - append-only, never overwritten,
// so different prompts/models can be compared side by side later.
model EnrichmentRun {
  id            String   @id @default(cuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id])
  model         String
  promptVersion String
  summary       String
  tags          String // JSON-encoded string[]
  category      String
  inputTokens   Int
  outputTokens  Int
  createdAt     DateTime @default(now())

  @@index([itemId])
}

// Per-hostname branding for the canvas cards - name, color, and a cached
// logo, resolved once per site and reused for every item from it. Keyed by
// normalized hostname ("www." stripped) so http/https and www variants share
// one row.
model SourceProfile {
  hostname    String   @id
  name        String // display name: "X", "YouTube", else the hostname
  color       String // header bar color, "#RRGGBB"
  textColor   String // "#ffffff" | "#000000" - precomputed for contrast on `color`
  iconBase64  String? // cached logo bytes, base64-encoded
  iconMime    String? // "image/png" | "image/svg+xml" | "image/x-icon" | ...
  colorSource String // "curated" | "theme-color" | "manifest" | "icon" | "hash"
  fetchFailed Boolean  @default(false)
  fetchedAt   DateTime @default(now())
}

// Logged chat Q&A exchanges - same append-only logic, doubles as an eval set.
model ChatTurn {
  id            String   @id @default(cuid())
  phone         String
  question      String
  answer        String
  model         String
  promptVersion String
  toolCalls     String? // JSON-encoded log of search_items calls made
  inputTokens   Int
  outputTokens  Int
  messageSid    String   @unique
  createdAt     DateTime @default(now())
}

// Guards against Twilio webhook retries double-processing the same inbound
// message, regardless of which command it maps to.
model ProcessedMessage {
  messageSid String   @id
  createdAt  DateTime @default(now())
}
