{
  "name": "whirlpool",
  "version": "0.1.0",
  "private": true,
  "description": "SMS brain-dump bot: text yourself links, get them summarized, tagged, and resurfaced later.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:tunnel": "tsx watch --env-file=.env.tunnel src/server.ts",
    "dev:cli": "tsx src/dev-cli.ts",
    "dev:chat": "tsx src/dev-chat.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "icons:build": "tsx src/build-icons.ts",
    "backfill:sources": "tsx src/backfill-sources.ts",
    "backfill:content": "tsx src/backfill-content.ts",
    "backfill:enrichment": "tsx src/backfill-enrichment.ts",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@mozilla/readability": "^0.5.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.74.0",
    "cookie-parser": "^1.4.7",
    "decode-ico": "^0.4.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.3.0",
    "jsdom": "^25.0.1",
    "libphonenumber-js": "^1.13.13",
    "node-cron": "^3.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.4",
    "twilio": "^5.3.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
