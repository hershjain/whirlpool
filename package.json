{
  "name": "whirlpool",
  "version": "0.1.0",
  "private": true,
  "description": "SMS brain-dump bot: text yourself links, get them summarized, tagged, and resurfaced later.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:cli": "tsx src/dev-cli.ts",
    "dev:chat": "tsx src/dev-chat.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "backfill:sources": "tsx src/backfill-sources.ts",
    "backfill:content": "tsx src/backfill-content.ts",
    "backfill:enrichment": "tsx src/backfill-enrichment.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@mozilla/readability": "^0.5.0",
    "@prisma/client": "^6.19.3",
    "decode-ico": "^0.4.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsdom": "^25.0.1",
    "node-cron": "^3.0.3",
    "sharp": "^0.35.4",
    "twilio": "^5.3.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
