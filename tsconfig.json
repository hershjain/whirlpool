{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  // dev-cli and dev-chat write real rows to the real database with no auth.
  // Harmless locally via tsx; compiled into dist/ they become a way to do that
  // on a production box, so they never reach the image.
  "exclude": ["src/dev-cli.ts", "src/dev-chat.ts"]
}
